@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContextAps> DbFactory

<PageTitle>Admin — AgentsPromptsSkills</PageTitle>

<div class="ui-page-header mb-4">
    <h1 class="h3"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</h1>
    <p class="text-muted mb-0">Platform overview and management.</p>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card ui-panel text-center">
                <div class="card-body">
                    <i class="bi bi-robot display-4 text-primary"></i>
                    <h3 class="mt-2">@_agentCount</h3>
                    <p class="text-muted mb-0">Agents</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card ui-panel text-center">
                <div class="card-body">
                    <i class="bi bi-chat-text display-4 text-success"></i>
                    <h3 class="mt-2">@_promptCount</h3>
                    <p class="text-muted mb-0">Prompts</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card ui-panel text-center">
                <div class="card-body">
                    <i class="bi bi-lightning-charge display-4 text-warning"></i>
                    <h3 class="mt-2">@_skillCount</h3>
                    <p class="text-muted mb-0">Skills</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card ui-panel text-center">
                <div class="card-body">
                    <i class="bi bi-people display-4 text-info"></i>
                    <h3 class="mt-2">@_userCount</h3>
                    <p class="text-muted mb-0">Users</p>
                </div>
            </div>
        </div>
    </div>

    <div class="ui-panel ui-anim-fade-up">
        <h5 class="mb-3">Management</h5>
        <div class="list-group list-group-flush">
            <a href="/admin/categories" class="list-group-item list-group-item-action">
                <i class="bi bi-tags me-2"></i> Categories
            </a>
            <a href="/admin/tags" class="list-group-item list-group-item-action">
                <i class="bi bi-tag me-2"></i> Tags
            </a>
            <a href="/admin/users" class="list-group-item list-group-item-action">
                <i class="bi bi-people me-2"></i> Users
            </a>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private int _agentCount;
    private int _promptCount;
    private int _skillCount;
    private int _userCount;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _agentCount  = await db.ApsAgents.CountAsync();
        _promptCount = await db.ApsPrompts.CountAsync();
        _skillCount  = await db.ApsSkills.CountAsync();
        _userCount   = await db.Users.CountAsync();
        _loading = false;
    }
}
