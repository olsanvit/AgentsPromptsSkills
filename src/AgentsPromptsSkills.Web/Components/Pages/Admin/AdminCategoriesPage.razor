@page "/admin/categories"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContextAps> DbFactory

<PageTitle>Categories — Admin</PageTitle>

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/admin" class="btn btn-outline-secondary btn-sm">← Admin</a>
    <h2 class="h4 mb-0"><i class="bi bi-tags me-2"></i>Categories</h2>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else
{
    <!-- New category form -->
    <div class="ui-panel mb-4">
        <h5 class="mb-3">Add Category</h5>
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Name</label>
                <input class="form-control form-control-sm" @bind="_newName" placeholder="Category name" maxlength="100" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Icon (emoji / bi-icon)</label>
                <input class="form-control form-control-sm" @bind="_newIcon" placeholder="🤖 or bi-robot" maxlength="50" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Color</label>
                <select class="form-select form-select-sm" @bind="_newColor">
                    <option value="primary">Primary</option>
                    <option value="secondary">Secondary</option>
                    <option value="success">Success</option>
                    <option value="danger">Danger</option>
                    <option value="warning">Warning</option>
                    <option value="info">Info</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Scope</label>
                <select class="form-select form-select-sm" @bind="_newScope">
                    <option value="0">All</option>
                    <option value="1">Agents only</option>
                    <option value="2">Prompts only</option>
                    <option value="3">Skills only</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary btn-sm w-100" @onclick="AddCategoryAsync"
                        disabled="@string.IsNullOrWhiteSpace(_newName)">
                    Add
                </button>
            </div>
        </div>
    </div>

    <!-- Categories table -->
    <div class="ui-panel">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Icon</th>
                    <th>Color</th>
                    <th>Scope</th>
                    <th style="width:120px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in _categories)
                {
                    @if (_editId == cat.Guid)
                    {
                        <tr>
                            <td><input class="form-control form-control-sm" @bind="_editName" /></td>
                            <td><input class="form-control form-control-sm" @bind="_editIcon" /></td>
                            <td>
                                <select class="form-select form-select-sm" @bind="_editColor">
                                    <option value="primary">Primary</option>
                                    <option value="secondary">Secondary</option>
                                    <option value="success">Success</option>
                                    <option value="danger">Danger</option>
                                    <option value="warning">Warning</option>
                                    <option value="info">Info</option>
                                </select>
                            </td>
                            <td>
                                <select class="form-select form-select-sm" @bind="_editScope">
                                    <option value="0">All</option>
                                    <option value="1">Agents</option>
                                    <option value="2">Prompts</option>
                                    <option value="3">Skills</option>
                                </select>
                            </td>
                            <td>
                                <button class="btn btn-success btn-sm me-1" @onclick="SaveEditAsync">Save</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _editId = null">Cancel</button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>
                                <span class="badge bg-@cat.Color me-1">@cat.Icon</span>
                                <strong>@cat.Name</strong>
                            </td>
                            <td class="text-muted small">@cat.Icon</td>
                            <td><span class="badge bg-@cat.Color">@cat.Color</span></td>
                            <td class="small">@((ApsCategoryScope)cat.Scope)</td>
                            <td>
                                <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => StartEdit(cat)">Edit</button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(cat.Guid)">Del</button>
                            </td>
                        </tr>
                    }
                }
                @if (!_categories.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-3">No categories yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_msg != null)
{
    <div class="alert @(_isErr ? "alert-danger" : "alert-success") mt-3">@_msg</div>
}

@code {
    private bool _loading = true;
    private List<ApsCategory> _categories = [];
    private string _newName = "";
    private string _newIcon = "";
    private string _newColor = "primary";
    private int _newScope = 0;
    private Guid? _editId;
    private string _editName = "";
    private string _editIcon = "";
    private string _editColor = "primary";
    private int _editScope = 0;
    private string? _msg;
    private bool _isErr;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _categories = await db.ApsCategories.OrderBy(c => c.Name).ToListAsync();
    }

    private async Task AddCategoryAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.ApsCategories.Add(new ApsCategory
        {
            Name = _newName.Trim(),
            Icon = _newIcon.Trim(),
            Color = _newColor,
            Scope = (ApsCategoryScope)_newScope
        });
        await db.SaveChangesAsync();
        _newName = "";
        _newIcon = "";
        await LoadAsync();
        _msg = "Category added.";
        _isErr = false;
    }

    private void StartEdit(ApsCategory cat)
    {
        _editId = cat.Guid;
        _editName = cat.Name;
        _editIcon = cat.Icon;
        _editColor = cat.Color;
        _editScope = (int)cat.Scope;
    }

    private async Task SaveEditAsync()
    {
        if (_editId == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var cat = await db.ApsCategories.FindAsync(_editId);
        if (cat != null)
        {
            cat.Name = _editName.Trim();
            cat.Icon = _editIcon.Trim();
            cat.Color = _editColor;
            cat.Scope = (ApsCategoryScope)_editScope;
            await db.SaveChangesAsync();
        }
        _editId = null;
        await LoadAsync();
        _msg = "Category updated.";
        _isErr = false;
    }

    private async Task DeleteAsync(Guid guid)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var cat = await db.ApsCategories.FindAsync(guid);
        if (cat != null)
        {
            db.ApsCategories.Remove(cat);
            await db.SaveChangesAsync();
        }
        await LoadAsync();
        _msg = "Deleted.";
        _isErr = false;
    }
}
