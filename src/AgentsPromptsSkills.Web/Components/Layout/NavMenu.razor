@inject NavigationManager Navigation

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <i class="bi bi-compass me-2"></i> Discover
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/agents">
                <i class="bi bi-robot me-2"></i> Agents
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/prompts">
                <i class="bi bi-chat-text me-2"></i> Prompts
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/skills">
                <i class="bi bi-lightning-charge me-2"></i> Skills
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/my-library">
                <i class="bi bi-bookmark-star me-2"></i> My Library
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/playground">
                <i class="bi bi-play-circle me-2"></i> Playground
            </NavLink>
        </div>

