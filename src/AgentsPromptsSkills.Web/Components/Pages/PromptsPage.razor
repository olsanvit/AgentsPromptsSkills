@page "/prompts"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContextAps> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Prompts — AgentsPromptsSkills</PageTitle>

<div class="ui-page-header mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h3"><i class="bi bi-chat-text me-2"></i>Prompts</h1>
        <p class="text-muted mb-0">Browse reusable prompts.</p>
    </div>
    <a href="/create/prompt" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Create New Prompt
    </a>
</div>

<div class="ui-panel ui-anim-fade-up mb-4">
    <div class="row g-2 mb-2">
        <div class="col-md-4">
            <input class="form-control" placeholder="Search prompts..." @bind="_search" @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="_typeFilter">
                <option value="">All types</option>
                <option value="General">General</option>
                <option value="AgentSystem">Agent System</option>
                <option value="AgentUser">Agent User</option>
                <option value="SkillInstruction">Skill Instruction</option>
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="_categoryFilter">
                <option value="">All categories</option>
                @foreach (var cat in _categories)
                {
                    <option value="@cat">@cat</option>
                }
            </select>
        </div>
    </div>
    @if (_tags.Count > 0)
    {
        <div class="d-flex flex-wrap gap-1 pt-1 border-top border-opacity-10">
            <button class="btn btn-sm @(_tagFilter == null ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => SetTagFilterAsync(null)">All tags</button>
            @foreach (var tag in _tags)
            {
                var isActive = _tagFilter == tag.Guid;
                <button class="btn btn-sm @(isActive ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => SetTagFilterAsync(isActive ? null : tag.Guid)">
                    # @tag.Name
                    <span class="badge bg-secondary ms-1">@_tagCounts.GetValueOrDefault(tag.Guid, 0)</span>
                </button>
            }
        </div>
    }
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else
{
    <div class="ui-panel ui-anim-fade-up">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Category</th>
                    <th>Visibility</th>
                    <th>Author</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prompt in FilteredPrompts)
                {
                    <tr>
                        <td>
                            <strong>@prompt.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(prompt.Description))
                            {
                                <br /><small class="text-muted">@(prompt.Description.Length > 80 ? prompt.Description[..80] + "…" : prompt.Description)</small>
                            }
                        </td>
                        <td><span class="badge bg-success">@prompt.PromptType.ToString()</span></td>
                        <td>@(string.IsNullOrEmpty(prompt.CategoryName) ? "—" : prompt.CategoryName)</td>
                        <td>
                            @if (prompt.IsPublic)
                            {
                                <span class="badge bg-success">Public</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Private</span>
                            }
                        </td>
                        <td><small class="text-muted">@prompt.OwnerName</small></td>
                        <td>
                            <a href="/prompts/@prompt.Guid" class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
                @if (!FilteredPrompts.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No prompts found.</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _loading = true;
    private string _search = "";
    private string _typeFilter = "";
    private string _categoryFilter = "";
    private Guid? _tagFilter;
    private string _userId = "";
    private List<ApsPrompt> _prompts = [];
    private List<string> _categories = [];
    private List<ApsTag> _tags = [];
    private Dictionary<Guid, int> _tagCounts = [];
    private HashSet<Guid> _taggedEntityIds = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        await using var db = await DbFactory.CreateDbContextAsync();
        _prompts = await db.ApsPrompts
            .Where(p => p.IsPublic || p.OwnerId == _userId)
            .OrderByDescending(p => p.CreatedAt)
            .ToListAsync();

        _categories = _prompts
            .Where(p => !string.IsNullOrWhiteSpace(p.CategoryName))
            .Select(p => p.CategoryName)
            .Distinct()
            .OrderBy(c => c)
            .ToList();

        var promptIds = _prompts.Select(p => p.Guid).ToHashSet();
        var links = await db.ApsTagLinks
            .Include(l => l.Tag)
            .Where(l => l.EntityType == "Prompt" && promptIds.Contains(l.EntityId))
            .ToListAsync();

        _tagCounts = links
            .GroupBy(l => l.TagId)
            .ToDictionary(g => g.Key, g => g.Count());

        _tags = links
            .Select(l => l.Tag)
            .DistinctBy(t => t.Guid)
            .OrderBy(t => t.Name)
            .ToList();

        _loading = false;
    }

    private IEnumerable<ApsPrompt> FilteredPrompts
    {
        get
        {
            var q = _prompts.AsEnumerable()
                .Where(p => string.IsNullOrWhiteSpace(_search) || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
                .Where(p => string.IsNullOrWhiteSpace(_typeFilter) || p.PromptType.ToString() == _typeFilter)
                .Where(p => string.IsNullOrWhiteSpace(_categoryFilter) || p.CategoryName == _categoryFilter);

            if (_tagFilter.HasValue)
                q = q.Where(p => _taggedEntityIds.Contains(p.Guid));

            return q;
        }
    }

    private async Task SetTagFilterAsync(Guid? tagId)
    {
        _tagFilter = tagId;
        if (tagId.HasValue)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var ids = await db.ApsTagLinks
                .Where(l => l.EntityType == "Prompt" && l.TagId == tagId.Value)
                .Select(l => l.EntityId)
                .ToListAsync();
            _taggedEntityIds = ids.ToHashSet();
        }
        else
        {
            _taggedEntityIds = [];
        }
    }
}
