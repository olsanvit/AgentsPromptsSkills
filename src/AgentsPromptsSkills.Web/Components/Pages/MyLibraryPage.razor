@page "/my-library"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<AppDbContextAps> DbFactory
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>My Library — AgentsPromptsSkills</PageTitle>

<div class="ui-page-header mb-4">
    <h1 class="h3"><i class="bi bi-bookmark-star me-2"></i>My Library</h1>
    <p class="text-muted mb-0">All items you have created or liked.</p>
</div>

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <button class="nav-link @(_tab == "agents" ? "active" : "")" @onclick='() => _tab = "agents"'>
            <i class="bi bi-robot me-1"></i> Agents (@_agents.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(_tab == "prompts" ? "active" : "")" @onclick='() => _tab = "prompts"'>
            <i class="bi bi-chat-text me-1"></i> Prompts (@_prompts.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(_tab == "skills" ? "active" : "")" @onclick='() => _tab = "skills"'>
            <i class="bi bi-lightning-charge me-1"></i> Skills (@_skills.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(_tab == "liked" ? "active" : "")" @onclick='() => _tab = "liked"'>
            <i class="bi bi-heart me-1"></i> Liked (@(_likedAgents.Count + _likedPrompts.Count + _likedSkills.Count))
        </button>
    </li>
</ul>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (_tab == "agents")
{
    <LibraryTable Items="_agents.Select(a => new LibraryRow(a.Guid, a.Name, a.Description, a.IsPublic, a.CreatedAt.UtcDateTime)).ToList()"
                  EditUrlPrefix="/agents"
                  OnTogglePublic="ToggleAgentPublic"
                  OnDelete="DeleteAgent" />
}
else if (_tab == "prompts")
{
    <LibraryTable Items="_prompts.Select(p => new LibraryRow(p.Guid, p.Name, p.Description, p.IsPublic, p.CreatedAt.UtcDateTime)).ToList()"
                  EditUrlPrefix="/prompts"
                  OnTogglePublic="TogglePromptPublic"
                  OnDelete="DeletePrompt" />
}
else if (_tab == "skills")
{
    <LibraryTable Items="_skills.Select(s => new LibraryRow(s.Guid, s.Name, s.Description, s.IsPublic, s.CreatedAt.UtcDateTime)).ToList()"
                  EditUrlPrefix="/skills"
                  OnTogglePublic="ToggleSkillPublic"
                  OnDelete="DeleteSkill" />
}
else if (_tab == "liked")
{
    @if (_likedAgents.Count + _likedPrompts.Count + _likedSkills.Count == 0)
    {
        <div class="ui-panel p-4 text-center text-muted">
            <i class="bi bi-heart fs-3 d-block mb-2"></i>
            You haven't liked anything yet. Browse <a href="/agents">agents</a>, <a href="/prompts">prompts</a> and <a href="/skills">skills</a>.
        </div>
    }
    else
    {
        @if (_likedAgents.Count > 0)
        {
            <h6 class="text-muted mt-2 mb-2"><i class="bi bi-robot me-1"></i>Liked Agents</h6>
            <div class="ui-panel mb-3">
                <table class="table table-hover mb-0">
                    <tbody>
                        @foreach (var a in _likedAgents)
                        {
                            <tr>
                                <td><strong>@a.Name</strong><br /><small class="text-muted">@(a.Description?.Length > 80 ? a.Description[..80] + "…" : a.Description)</small></td>
                                <td class="text-end"><a href="/agents/@a.Guid" class="btn btn-sm btn-outline-primary">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (_likedPrompts.Count > 0)
        {
            <h6 class="text-muted mt-2 mb-2"><i class="bi bi-chat-text me-1"></i>Liked Prompts</h6>
            <div class="ui-panel mb-3">
                <table class="table table-hover mb-0">
                    <tbody>
                        @foreach (var p in _likedPrompts)
                        {
                            <tr>
                                <td><strong>@p.Name</strong><br /><small class="text-muted">@(p.Description?.Length > 80 ? p.Description[..80] + "…" : p.Description)</small></td>
                                <td class="text-end"><a href="/prompts/@p.Guid" class="btn btn-sm btn-outline-primary">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (_likedSkills.Count > 0)
        {
            <h6 class="text-muted mt-2 mb-2"><i class="bi bi-lightning-charge me-1"></i>Liked Skills</h6>
            <div class="ui-panel mb-3">
                <table class="table table-hover mb-0">
                    <tbody>
                        @foreach (var s in _likedSkills)
                        {
                            <tr>
                                <td><strong>@s.Name</strong><br /><small class="text-muted">@(s.Description?.Length > 80 ? s.Description[..80] + "…" : s.Description)</small></td>
                                <td class="text-end"><a href="/skills/@s.Guid" class="btn btn-sm btn-outline-primary">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

@code {
    private bool _loading = true;
    private string _tab = "agents";
    private string _userId = "";
    private List<ApsAgent> _agents = [];
    private List<ApsPrompt> _prompts = [];
    private List<ApsSkill> _skills = [];
    private List<ApsAgent> _likedAgents = [];
    private List<ApsPrompt> _likedPrompts = [];
    private List<ApsSkill> _likedSkills = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        await using var db = await DbFactory.CreateDbContextAsync();
        _agents  = await db.ApsAgents.Where(a => a.OwnerId == _userId).OrderByDescending(a => a.CreatedAt).ToListAsync();
        _prompts = await db.ApsPrompts.Where(p => p.OwnerId == _userId).OrderByDescending(p => p.CreatedAt).ToListAsync();
        _skills  = await db.ApsSkills.Where(s => s.OwnerId == _userId).OrderByDescending(s => s.CreatedAt).ToListAsync();

        var likes = await db.ApsLikes.Where(l => l.OwnerId == _userId).ToListAsync();
        var likedAgentIds = likes.Where(l => l.EntityType == "Agent").Select(l => l.EntityId).ToHashSet();
        var likedPromptIds = likes.Where(l => l.EntityType == "Prompt").Select(l => l.EntityId).ToHashSet();
        var likedSkillIds = likes.Where(l => l.EntityType == "Skill").Select(l => l.EntityId).ToHashSet();

        if (likedAgentIds.Count > 0)
            _likedAgents = await db.ApsAgents.Where(a => likedAgentIds.Contains(a.Guid)).OrderBy(a => a.Name).ToListAsync();
        if (likedPromptIds.Count > 0)
            _likedPrompts = await db.ApsPrompts.Where(p => likedPromptIds.Contains(p.Guid)).OrderBy(p => p.Name).ToListAsync();
        if (likedSkillIds.Count > 0)
            _likedSkills = await db.ApsSkills.Where(s => likedSkillIds.Contains(s.Guid)).OrderBy(s => s.Name).ToListAsync();

        _loading = false;
    }

    private async Task ToggleAgentPublic(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var agent = await db.ApsAgents.FindAsync(id);
        if (agent is null || agent.OwnerId != _userId) return;
        agent.IsPublic = !agent.IsPublic;
        await db.SaveChangesAsync();
        var item = _agents.FirstOrDefault(a => a.Guid == id);
        if (item is not null) item.IsPublic = agent.IsPublic;
    }

    private async Task DeleteAgent(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var agent = await db.ApsAgents.FindAsync(id);
        if (agent is null || agent.OwnerId != _userId) return;
        db.ApsAgents.Remove(agent);
        await db.SaveChangesAsync();
        _agents.RemoveAll(a => a.Guid == id);
    }

    private async Task TogglePromptPublic(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var prompt = await db.ApsPrompts.FindAsync(id);
        if (prompt is null || prompt.OwnerId != _userId) return;
        prompt.IsPublic = !prompt.IsPublic;
        await db.SaveChangesAsync();
        var item = _prompts.FirstOrDefault(p => p.Guid == id);
        if (item is not null) item.IsPublic = prompt.IsPublic;
    }

    private async Task DeletePrompt(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var prompt = await db.ApsPrompts.FindAsync(id);
        if (prompt is null || prompt.OwnerId != _userId) return;
        db.ApsPrompts.Remove(prompt);
        await db.SaveChangesAsync();
        _prompts.RemoveAll(p => p.Guid == id);
    }

    private async Task ToggleSkillPublic(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var skill = await db.ApsSkills.FindAsync(id);
        if (skill is null || skill.OwnerId != _userId) return;
        skill.IsPublic = !skill.IsPublic;
        await db.SaveChangesAsync();
        var item = _skills.FirstOrDefault(s => s.Guid == id);
        if (item is not null) item.IsPublic = skill.IsPublic;
    }

    private async Task DeleteSkill(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var skill = await db.ApsSkills.FindAsync(id);
        if (skill is null || skill.OwnerId != _userId) return;
        db.ApsSkills.Remove(skill);
        await db.SaveChangesAsync();
        _skills.RemoveAll(s => s.Guid == id);
    }

    public record LibraryRow(Guid Id, string Name, string? Description, bool IsPublic, DateTime CreatedAt);
}
