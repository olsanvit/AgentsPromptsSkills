@* AUDIT:PENDING|Nízký|Soft-deleted záznamy se zobrazují – chybí IsDeleted filter *@
@page "/agents"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContextAps> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Agents — AgentsPromptsSkills</PageTitle>

<div class="ui-page-header mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h3"><i class="bi bi-robot me-2"></i>Agents</h1>
        <p class="text-muted mb-0">Browse and manage AI agents.</p>
    </div>
    <a href="/create/agent" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Create New Agent
    </a>
</div>

<div class="ui-panel ui-anim-fade-up mb-4">
    <div class="row g-2 mb-2">
        <div class="col-md-4">
            <input class="form-control" placeholder="Search agents..." @bind="_search" @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="_categoryFilter">
                <option value="">All categories</option>
                @foreach (var cat in _categories)
                {
                    <option value="@cat">@cat</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="_sortOrder">
                <option value="newest">Nejnovější</option>
                <option value="oldest">Nejstarší</option>
                <option value="likes">Nejoblíbenější</option>
                <option value="views">Nejsledovanější</option>
                <option value="usage">Nejvíce použité</option>
                <option value="forks">Nejvíce forknuté</option>
            </select>
        </div>
    </div>
    @if (_tags.Count > 0)
    {
        <div class="d-flex flex-wrap gap-1 pt-1 border-top border-opacity-10">
            <button class="btn btn-sm @(_tagFilter == null ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => SetTagFilterAsync(null)">All tags</button>
            @foreach (var tag in _tags)
            {
                var isActive = _tagFilter == tag.Guid;
                <button class="btn btn-sm @(isActive ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => SetTagFilterAsync(isActive ? null : tag.Guid)">
                    # @tag.Name
                    <span class="badge bg-secondary ms-1">@_tagCounts.GetValueOrDefault(tag.Guid, 0)</span>
                </button>
            }
        </div>
    }
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else
{
    <div class="ui-panel ui-anim-fade-up">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Model</th>
                    <th>Category</th>
                    <th>Visibility</th>
                    <th>Likes</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var agent in FilteredAgents)
                {
                    <tr>
                        <td>
                            <strong>@agent.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(agent.Description))
                            {
                                <br /><small class="text-muted">@(agent.Description.Length > 80 ? agent.Description[..80] + "…" : agent.Description)</small>
                            }
                        </td>
                        <td><span class="badge bg-info text-dark">@(agent.ModelName ?? "—")</span></td>
                        <td>@(string.IsNullOrEmpty(agent.CategoryName) ? "—" : agent.CategoryName)</td>
                        <td>
                            @if (agent.IsPublic)
                            {
                                <span class="badge bg-success">Public</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Private</span>
                            }
                        </td>
                        <td>@agent.LikeCount</td>
                        <td>
                            <a href="/agents/@agent.Guid" class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
                @if (!FilteredAgents.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No agents found.</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _loading = true;
    private string _search = "";
    private string _categoryFilter = "";
    private string _sortOrder = "newest";
    private Guid? _tagFilter;
    private string _userId = "";
    private List<ApsAgent> _agents = [];
    private List<string> _categories = [];
    private List<ApsTag> _tags = [];
    private Dictionary<Guid, int> _tagCounts = [];
    private HashSet<Guid> _taggedEntityIds = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        await using var db = await DbFactory.CreateDbContextAsync();
        _agents = await db.ApsAgents
            .Where(a => a.IsPublic || a.OwnerId == _userId)
            .OrderByDescending(a => a.CreatedAt)
            .ToListAsync();

        _categories = _agents
            .Where(a => !string.IsNullOrWhiteSpace(a.CategoryName))
            .Select(a => a.CategoryName)
            .Distinct()
            .OrderBy(c => c)
            .ToList();

        var agentIds = _agents.Select(a => a.Guid).ToHashSet();
        var links = await db.ApsTagLinks
            .Include(l => l.Tag)
            .Where(l => l.EntityType == "Agent" && agentIds.Contains(l.EntityId))
            .ToListAsync();

        _tagCounts = links.GroupBy(l => l.TagId).ToDictionary(g => g.Key, g => g.Count());
        _tags = links.Select(l => l.Tag).DistinctBy(t => t.Guid).OrderBy(t => t.Name).ToList();

        _loading = false;
    }

    private IEnumerable<ApsAgent> FilteredAgents
    {
        get
        {
            var q = _agents.AsEnumerable()
                .Where(a => string.IsNullOrWhiteSpace(_search) || a.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
                .Where(a => string.IsNullOrWhiteSpace(_categoryFilter) || a.CategoryName == _categoryFilter);
            if (_tagFilter.HasValue)
                q = q.Where(a => _taggedEntityIds.Contains(a.Guid));
            q = _sortOrder switch
            {
                "oldest" => q.OrderBy(a => a.CreatedAt),
                "likes"  => q.OrderByDescending(a => a.LikeCount),
                "views"  => q.OrderByDescending(a => a.ViewCount),
                "usage"  => q.OrderByDescending(a => a.UsageCount),
                "forks"  => q.OrderByDescending(a => a.ForkCount),
                _        => q.OrderByDescending(a => a.CreatedAt),
            };
            return q;
        }
    }

    private async Task SetTagFilterAsync(Guid? tagId)
    {
        _tagFilter = tagId;
        if (tagId.HasValue)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var ids = await db.ApsTagLinks
                .Where(l => l.EntityType == "Agent" && l.TagId == tagId.Value)
                .Select(l => l.EntityId).ToListAsync();
            _taggedEntityIds = ids.ToHashSet();
        }
        else { _taggedEntityIds = []; }
    }
}
