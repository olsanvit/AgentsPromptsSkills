                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/tags">
                        <i class="bi bi-tag me-2"></i> Tags
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/users">
                        <i class="bi bi-people me-2"></i> Users
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <LangSwitcher />
