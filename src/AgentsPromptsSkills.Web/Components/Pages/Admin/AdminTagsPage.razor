@page "/admin/tags"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContextAps> DbFactory

<PageTitle>Tags — Admin</PageTitle>

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/admin" class="btn btn-outline-secondary btn-sm">← Admin</a>
    <h2 class="h4 mb-0"><i class="bi bi-tag me-2"></i>Tags</h2>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else
{
    <!-- Add tag -->
    <div class="ui-panel mb-4">
        <h5 class="mb-3">Add Tag</h5>
        <div class="d-flex gap-2 align-items-end">
            <div>
                <label class="form-label small">Tag name</label>
                <input class="form-control form-control-sm" @bind="_newName" placeholder="e.g. coding"
                       maxlength="50" @onkeydown="HandleKeyDown" />
            </div>
            <button class="btn btn-primary btn-sm" @onclick="AddTagAsync"
                    disabled="@string.IsNullOrWhiteSpace(_newName)">Add</button>
        </div>
    </div>

    <!-- Tags list -->
    <div class="ui-panel">
        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <input class="form-control form-control-sm" placeholder="Search tags..."
                       @bind="_search" @bind:event="oninput" />
            </div>
            <div class="col-auto">
                <span class="text-muted small align-self-center">@Filtered.Count() / @_tags.Count tags</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Tag</th>
                        <th>Used on Agents</th>
                        <th>Used on Prompts</th>
                        <th>Used on Skills</th>
                        <th style="width:100px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tag in Filtered)
                    {
                        @if (_editId == tag.Guid)
                        {
                            <tr>
                                <td>
                                    <input class="form-control form-control-sm" @bind="_editName" maxlength="50" />
                                </td>
                                <td colspan="3"></td>
                                <td>
                                    <button class="btn btn-success btn-sm me-1" @onclick="SaveEditAsync">Save</button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _editId = null">Cancel</button>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border"># @tag.Name</span></td>
                                <td class="text-muted small">@_counts.GetValueOrDefault((tag.Guid, "Agent"), 0)</td>
                                <td class="text-muted small">@_counts.GetValueOrDefault((tag.Guid, "Prompt"), 0)</td>
                                <td class="text-muted small">@_counts.GetValueOrDefault((tag.Guid, "Skill"), 0)</td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => StartEdit(tag)">Edit</button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(tag.Guid)"
                                            disabled="@(_counts.GetValueOrDefault((tag.Guid, "Agent"), 0) + _counts.GetValueOrDefault((tag.Guid, "Prompt"), 0) + _counts.GetValueOrDefault((tag.Guid, "Skill"), 0) > 0)">
                                        Del
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    @if (!Filtered.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">No tags found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_msg != null)
{
    <div class="alert @(_isErr ? "alert-danger" : "alert-success") mt-3">@_msg</div>
}

@code {
    private bool _loading = true;
    private List<ApsTag> _tags = [];
    private Dictionary<(Guid TagId, string EntityType), int> _counts = new();
    private string _search = "";
    private string _newName = "";
    private Guid? _editId;
    private string _editName = "";
    private string? _msg;
    private bool _isErr;

    private IEnumerable<ApsTag> Filtered => _tags.Where(t =>
        string.IsNullOrEmpty(_search) || t.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _tags = await db.ApsTags.OrderBy(t => t.Name).ToListAsync();
        var links = await db.ApsTagLinks.ToListAsync();
        _counts = links.GroupBy(l => (l.TagId, l.EntityType))
                       .ToDictionary(g => g.Key, g => g.Count());
    }

    private async Task AddTagAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var name = _newName.Trim().ToLower();
        if (await db.ApsTags.AnyAsync(t => t.Name == name))
        {
            _msg = "Tag already exists.";
            _isErr = true;
            return;
        }
        db.ApsTags.Add(new ApsTag { Name = name });
        await db.SaveChangesAsync();
        _newName = "";
        await LoadAsync();
        _msg = "Tag added.";
        _isErr = false;
    }

    private void StartEdit(ApsTag tag)
    {
        _editId = tag.Guid;
        _editName = tag.Name;
    }

    private async Task SaveEditAsync()
    {
        if (_editId == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var tag = await db.ApsTags.FindAsync(_editId);
        if (tag != null)
        {
            tag.Name = _editName.Trim().ToLower();
            await db.SaveChangesAsync();
        }
        _editId = null;
        await LoadAsync();
        _msg = "Tag updated.";
        _isErr = false;
    }

    private async Task DeleteAsync(Guid guid)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var tag = await db.ApsTags.FindAsync(guid);
        if (tag != null)
        {
            db.ApsTags.Remove(tag);
            await db.SaveChangesAsync();
        }
        await LoadAsync();
        _msg = "Deleted.";
        _isErr = false;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddTagAsync();
    }
}
