@page "/agents"
@inject IDbContextFactory<AppDbContextAps> DbFactory

<PageTitle>Agents</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <i class="bi bi-robot text-accent fs-5"></i>
    <h5 class="fw-bold mb-0">Agents</h5>
</div>

<div class="mb-3">
    <input class="form-control form-control-sm"
           placeholder="Search agents..."
           @bind="_search"
           @bind:event="oninput" />
</div>

@if (_loading)
{
    <div class="text-muted small text-center py-3">Loading...</div>
}
else if (_agents.Count == 0)
{
    <div class="text-muted small text-center py-3">No agents found.</div>
}
else
{
    <div class="d-flex flex-column gap-2">
        @foreach (var agent in Filtered)
        {
            <div class="ui-panel p-3">
                <div class="fw-semibold small">@agent.Name</div>
                @if (!string.IsNullOrWhiteSpace(agent.Description))
                {
                    <div class="text-muted" style="font-size:.75rem">@agent.Description</div>
                }
                @if (!string.IsNullOrWhiteSpace(agent.Tags))
                {
                    <div class="mt-1">
                        @foreach (var tag in agent.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <span class="badge bg-secondary me-1" style="font-size:.65rem">@tag</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<Agent> _agents = [];
    private string _search = string.Empty;
    private bool _loading = true;

    private IEnumerable<Agent> Filtered => string.IsNullOrWhiteSpace(_search)
        ? _agents
        : _agents.Where(a => a.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                           || (a.Description ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _agents = await db.Agents
            .Where(a => a.IsPublic)
            .OrderBy(a => a.Name)
            .ToListAsync();
        _loading = false;
    }
}
