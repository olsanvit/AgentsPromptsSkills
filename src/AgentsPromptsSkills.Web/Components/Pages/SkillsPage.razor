@page "/skills"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContextAps> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Skills — AgentsPromptsSkills</PageTitle>

<div class="ui-page-header mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h3"><i class="bi bi-lightning-charge me-2"></i>Skills</h1>
        <p class="text-muted mb-0">Browse reusable skill implementations.</p>
    </div>
    <a href="/create/skill" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Create New Skill
    </a>
</div>

<div class="ui-panel ui-anim-fade-up mb-4">
    <div class="row g-2 mb-2">
        <div class="col-md-5">
            <input class="form-control" placeholder="Search skills..." @bind="_search" @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="_typeFilter">
                <option value="">All types</option>
                <option value="ClaudeCode">Claude Code</option>
                <option value="AgentSDK">Agent SDK</option>
                <option value="Custom">Custom</option>
            </select>
        </div>
    </div>
    @if (_tags.Count > 0)
    {
        <div class="d-flex flex-wrap gap-1 pt-1 border-top border-opacity-10">
            <button class="btn btn-sm @(_tagFilter == null ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => SetTagFilterAsync(null)">All tags</button>
            @foreach (var tag in _tags)
            {
                var isActive = _tagFilter == tag.Guid;
                <button class="btn btn-sm @(isActive ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => SetTagFilterAsync(isActive ? null : tag.Guid)">
                    # @tag.Name
                    <span class="badge bg-secondary ms-1">@_tagCounts.GetValueOrDefault(tag.Guid, 0)</span>
                </button>
            }
        </div>
    }
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var skill in FilteredSkills)
        {
            <div class="col">
                <div class="card h-100 ui-panel">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@skill.Name</h5>
                            <span class="badge bg-warning text-dark">@skill.SkillType.ToString()</span>
                        </div>
                        <p class="card-text text-muted small">
                            @(skill.Description?.Length > 120 ? skill.Description[..120] + "…" : skill.Description)
                        </p>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-muted">@skill.OwnerName</small>
                            @if (skill.IsPublic)
                            {
                                <span class="badge bg-success">Public</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Private</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0">
                        <a href="/skills/@skill.Guid" class="btn btn-sm btn-outline-primary w-100">View</a>
                    </div>
                </div>
            </div>
        }
        @if (!FilteredSkills.Any())
        {
            <div class="col-12 text-center text-muted py-5">No skills found.</div>
        }
    </div>
}

@code {
    private bool _loading = true;
    private string _search = "";
    private string _typeFilter = "";
    private Guid? _tagFilter;
    private string _userId = "";
    private List<ApsSkill> _skills = [];
    private List<ApsTag> _tags = [];
    private Dictionary<Guid, int> _tagCounts = [];
    private HashSet<Guid> _taggedEntityIds = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        await using var db = await DbFactory.CreateDbContextAsync();
        _skills = await db.ApsSkills
            .Where(s => s.IsPublic || s.OwnerId == _userId)
            .OrderByDescending(s => s.CreatedAt)
            .ToListAsync();

        var skillIds = _skills.Select(s => s.Guid).ToHashSet();
        var links = await db.ApsTagLinks
            .Include(l => l.Tag)
            .Where(l => l.EntityType == "Skill" && skillIds.Contains(l.EntityId))
            .ToListAsync();

        _tagCounts = links.GroupBy(l => l.TagId).ToDictionary(g => g.Key, g => g.Count());
        _tags = links.Select(l => l.Tag).DistinctBy(t => t.Guid).OrderBy(t => t.Name).ToList();

        _loading = false;
    }

    private IEnumerable<ApsSkill> FilteredSkills
    {
        get
        {
            var q = _skills.AsEnumerable()
                .Where(s => string.IsNullOrWhiteSpace(_search) || s.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
                .Where(s => string.IsNullOrWhiteSpace(_typeFilter) || s.SkillType.ToString() == _typeFilter);
            if (_tagFilter.HasValue)
                q = q.Where(s => _taggedEntityIds.Contains(s.Guid));
            return q;
        }
    }

    private async Task SetTagFilterAsync(Guid? tagId)
    {
        _tagFilter = tagId;
        if (tagId.HasValue)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var ids = await db.ApsTagLinks
                .Where(l => l.EntityType == "Skill" && l.TagId == tagId.Value)
                .Select(l => l.EntityId).ToListAsync();
            _taggedEntityIds = ids.ToHashSet();
        }
        else { _taggedEntityIds = []; }
    }
}
